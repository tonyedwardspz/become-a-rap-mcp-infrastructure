@page "/"

@inherits CatalogPageBase
@inject CatalogClient Catalog

<PageTitle>Albums - Music catalog</PageTitle>

@if (ErrorMessage is not null)
{
    <LoadError Message="@ErrorMessage" />
}
else
{
    <p class="eyebrow">The collection</p>
    <h1>Explore the albums</h1>
    <p class="intro">Browse by album artist, follow the credits, and discover who appears on each track.</p>
    @if (_albums.Count == 0)
    {
        <p>No albums have been added to the catalog yet.</p>
    }
    @foreach (var group in _albums.GroupBy(album => album.ArtistId).OrderBy(group => group.First().ArtistName))
    {
        <section class="catalog-section">
            <h2><a href="/artists/@group.Key">@group.First().ArtistName</a> <span class="count">@group.Count()</span></h2>
            <AlbumList Albums="group.ToList()" />
        </section>
    }
}

@code {
    private IReadOnlyList<AlbumSummary> _albums = [];
    protected override Task OnInitializedAsync() =>
        LoadAsync(async () => _albums = await Catalog.GetAlbumsAsync(RequestCancellation));
}
