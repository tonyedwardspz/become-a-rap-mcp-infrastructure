@inherits LayoutComponentBase

@inject NavigationManager Navigation

<header class="site-header">
    <a class="brand" href="/">Become a Rap <span>Music catalog</span></a>
    <form class="search-form" action="/search" method="get" data-enhance="false">
        <label for="catalog-search">Search the catalog</label>
        <div class="search-controls">
            <input id="catalog-search" type="search" name="q" value="@Query"
                   placeholder="Album, artist, or track" />
            <button type="submit">Search</button>
        </div>
    </form>
</header>
<main id="main-content">
    @Body
</main>
<footer>Read-only catalog. Explore the music and the people behind it.</footer>

@code {
    private string? Query => Microsoft.AspNetCore.WebUtilities.QueryHelpers
        .ParseQuery(new Uri(Navigation.Uri).Query).TryGetValue("q", out var value) ? value.ToString() : null;
}
